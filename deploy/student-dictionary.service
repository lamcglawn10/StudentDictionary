[Unit]
Description=Student Dictionary Flask API (Gunicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/studentdictionary
EnvironmentFile=/home/ubuntu/studentdictionary/.env
ExecStart=/home/ubuntu/studentdictionary/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8000 --access-logfile - app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
